{
  "name": "editorial-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,worker \"next dev -H 127.0.0.1 -p 3100\" \"tsx src/worker/index.ts\"",
    "build": "prisma generate && next build",
    "start": "concurrently -n web,worker \"next start -H 127.0.0.1 -p 3100\" \"tsx src/worker/index.ts\"",
    "worker": "tsx src/worker/index.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "tsx tests/e2e/full-workflow.ts",
    "postinstall": "prisma generate",
    "test:attack": "tsx tests/security/attack-suite.ts",
    "audit:deps": "npm audit --audit-level=high",
    "audit:all": "npm run typecheck && npm test && npm run audit:deps && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.6",
    "diff": "^9.0.0",
    "docx": "^9.15.2",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "next": "^15.5.29",
    "node-html-parser": "^9.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/diff": "^7.0.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.4",
    "typescript": "5.9",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "deepmerge-ts": "^8.0.0"
  }
}

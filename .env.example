# Postgres connection
DATABASE_URL="postgresql://studio:studio@localhost:5432/editorial_studio"

# Where original uploads and exports are stored (private; never served directly)
STORAGE_DIR="./storage"

# Your name, shown on the dashboard (single-author mode)
OWNER_NAME="Mark"

# AI editor. By default the app uses your Claude subscription through the Claude Code
# app installed and signed in on this computer (no API key, no extra cost).
# AI_PROVIDER="claude-code"        # claude-code | anthropic | rules
# AI_MODEL="opus"                  # claude-code: opus | sonnet | haiku, or a full model id
# CLAUDE_CLI="claude"              # path to the Claude Code command if it isn't on PATH
# Optional alternative: pay-as-you-go API key (only used with AI_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=""
# AI_EFFORT="medium"               # chapter editing effort: low | medium | high | xhigh | max
# AI_ANALYSIS_EFFORT="high"        # whole-manuscript analysis effort

# Tuning
# EDIT_CHUNK_WORDS=2500            # words per AI request (split at paragraph boundaries)
# ANALYSIS_WORD_BUDGET=150000      # longer books are excerpted evenly for analysis
# WORKER_POLL_MS=2000

# Postgres connection
DATABASE_URL="postgresql://studio:studio@localhost:5432/editorial_studio"

# Where original uploads and exports are stored (private; never served directly)
STORAGE_DIR="./storage"

# Your name, shown on the dashboard (single-author mode)
OWNER_NAME="Mark"

# AI editor. Set ANTHROPIC_API_KEY to use Claude. Without it, only automatic mechanical
# checks run (AI_PROVIDER=rules), and the app says so.
ANTHROPIC_API_KEY=""
# AI_PROVIDER="anthropic"          # anthropic | rules (default: anthropic if a key is set)
# AI_MODEL="claude-opus-5-5"       # any current Claude model id
# AI_EFFORT="medium"               # chapter editing effort: low | medium | high | xhigh | max
# AI_ANALYSIS_EFFORT="high"        # whole-manuscript analysis effort

# Tuning
# EDIT_CHUNK_WORDS=2500            # words per AI request (split at paragraph boundaries)
# ANALYSIS_WORD_BUDGET=150000      # longer books are excerpted evenly for analysis
# WORKER_POLL_MS=2000
